{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneDocument",
  "type": "object",
  "required": ["width", "height", "deltaSetLike"],
  "properties": {
    "width": { "type": "number" },
    "height": { "type": "number" },
    "deltaSetLike": {
      "type": "object",
      "required": ["ROOT"],
      "properties": {
        "ROOT": {
          "type": "object",
          "required": ["children"],
          "properties": {
            "key": { "type": "string" },
            "children": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["key", "x", "y", "width", "height"],
        "properties": {
          "key": { "enum": ["text", "rect", "image"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "attrs": { "type": "object" }
        }
      }
    }
  }
}
