{
  "name": "@recombyn/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./generated/api/orpc.gen.ts",
      "import": "./generated/api/orpc.gen.ts",
      "default": "./generated/api/orpc.gen.ts"
    }
  },
  "scripts": {
    "export-openapi": "node ./scripts/export-openapi.mjs",
    "gen": "npm run export-openapi && openapi-ts -f openapi-ts.config.ts",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "^1.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@repo/tsconfig": "*",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.0"
  }
}
