{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Recombyn Cloud",
  "version": "0.1.0",
  "identifier": "com.recombyn.app.cloud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev -- --mode cloud",
    "beforeBuildCommand": "npm run build -- --mode cloud"
  },
  "app": {
    "windows": [
      {
        "title": "Recombyn Cloud",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

