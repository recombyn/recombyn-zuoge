# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:3000 (and prod URL)
# Authorized redirect URIs: http://localhost:3000/login/google/callback
GOOGLE_CLIENT_ID=
# Optional alias
# VITE_GOOGLE_CLIENT_ID=

# Docs site (help + legal). Unset in local → http://localhost:5175 (private docs repo).
# Production builds default to GitHub Pages: https://recombyn.github.io/recombyn
# VITE_DOCS_URL=http://localhost:5175
# VITE_DOCS_URL=https://recombyn.github.io/recombyn

# Canvas multiplayer (Yjs). Vite DEV defaults ON (disable with ?collab=0).
# Production builds: bake via Docker build-arg VITE_COLLAB_ENABLED (compose default true).
# Requires apps/collab + COLLAB_TOKEN_SECRET / COLLAB_PUBLIC_WS_URL on API.
# VITE_COLLAB_ENABLED=true
# VITE_COLLAB_ENABLED=false

# SoA + WebGL2 + atlas: product always on (Vitest off). No env kill-switches.
# OffscreenCanvas bake at idle+basic SoA count (default 800). Worker-only in browser.
# VITE_SOA_BAKE_THRESHOLD=800
# VITE_SOA_BAKE_TILE=2048

# GPU depth-of-field — Effects opt-in (not density / 10k FPS roadmap).
# VITE_GPU_DOF=1
# VITE_GPU_DOF_BACKEND=webgpu
# VITE_GPU_DOF_BACKEND=webgl2

# Desktop (set by npm run dev:desktop / build:desktop — leave unset for browser-only).
# VITE_API_BASE_URL=https://recombyn.com
# Optional: change local API port when 8000 is occupied (Vite proxy + npm run dev:api).
# VITE_DEV_API_PORT=8000
