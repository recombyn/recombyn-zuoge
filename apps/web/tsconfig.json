{
  "extends": "@repo/tsconfig/react-web.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@commercial/*": ["./src/commercial/*", "./src/commercial-oss/*"],
      "@canvas-plugins/*": ["../../plugins/canvas/*"]
    }
  },
  "include": ["src", "./src/commercial", "./src/commercial-oss", "../../plugins/canvas", "vite.config.ts"],
  "exclude": ["src/private"]
}
