INTELLIGENCE_SERVICE_API_KEY=dev-key
INTELLIGENCE_SERVICE_HOST=0.0.0.0
INTELLIGENCE_SERVICE_PORT=8091
# Image layer pipeline workspace (depth / matting / inpaint jobs)
# ILP_WORKSPACE=./workspace
# ILP_MAX_JOB_WORKERS=2
# ILP_CONFIG_YAML=./configs/image_layer_default.yaml
# Optional queue (Redis + Celery worker)
# ILP_REDIS_URL=redis://127.0.0.1:6379/0
# ILP_USE_CELERY=false
# Flux inpaint (large repair masks when routing.flux_enabled=true)
# FAL_KEY=
# ILP_FLUX_API_KEY=
# ILP_FLUX_API_URL=https://fal.run/fal-ai/flux-pro/v1/fill
# Taste / KG runtime dir (seed is in-code; runtime_kg.json is written here)
# INTELLIGENCE_TASTE_DIR=./data/taste

# Embedding backend for Taste retrieve / write (optional)
# auto (default) | hashed | openai
# INTELLIGENCE_EMBEDDING_BACKEND=auto
# INTELLIGENCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# INTELLIGENCE_EMBEDDING_API_KEY=sk-...
# INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small
# INTELLIGENCE_EMBEDDING_TIMEOUT_SEC=20
