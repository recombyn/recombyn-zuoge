INTELLIGENCE_SERVICE_API_KEY=dev-key
INTELLIGENCE_SERVICE_HOST=0.0.0.0
INTELLIGENCE_SERVICE_PORT=8091
# Image layer pipeline workspace (depth / matting / inpaint jobs)
# ILP_WORKSPACE=./workspace
# ILP_MAX_JOB_WORKERS=2
# ILP_CONFIG_YAML=./configs/image_layer_default.yaml
# Optional queue (Redis + Celery worker)
# ILP_REDIS_URL=redis://127.0.0.1:6379/0
# ILP_USE_CELERY=false
# Speed: cap inference long-edge (default 2048); mask upscaled back to original
# ILP_INFER_MAX_LONG_EDGE=2048
# ILP_MATTING_CACHE=1
# ILP_MATTING_CACHE_DIR=./workspace/cache/matting
# Warm models on startup (matting ONNX); OCR/LaMa opt-in
# ILP_WARMUP=1
# ILP_WARMUP_OCR=0
# ILP_WARMUP_LAMA=0
# Faster Mark / removeBg: skip SAM ROI crop (quality tradeoff)
# ILP_DISABLE_SAM_ROI=1
# Flux inpaint (large repair masks when routing.flux_enabled=true)
# FAL_KEY=
# ILP_FLUX_API_KEY=
# ILP_FLUX_API_URL=https://fal.run/fal-ai/flux-pro/v1/fill
# Local commercial vision weights (see docs/commercial-models.md)
# U2NET_HOME=./models
# ILP_MATTING_ONNX=./models/BiRefNet_lite.onnx
# ILP_ESRGAN_MODEL_PATH=./models/RealESRGAN_x4plus.onnx
# ILP_HR_MATTING_DOWNLOAD_URL=https://huggingface.co/emrikol/birefnet-matting-onnx/resolve/main/birefnet-matting.onnx
# ILP_ESRGAN_DOWNLOAD_URL=https://huggingface.co/Meeperomi/RealESRGAN_x4-onnx/resolve/main/RealESRGAN_x4.onnx

# Embedding backend for Taste retrieve / write (optional)
# auto (default) | hashed | openai
# INTELLIGENCE_EMBEDDING_BACKEND=auto
# INTELLIGENCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# INTELLIGENCE_EMBEDDING_API_KEY=sk-...
# INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small
# INTELLIGENCE_EMBEDDING_TIMEOUT_SEC=20
